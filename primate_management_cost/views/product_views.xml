<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_management_cost" model="ir.ui.view">
        <field name="name">product.template.form.management.cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="after">
                <field name="ultimo_costo_mr" readonly="1"/>
                <field name="management_cost" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_product_form_management_cost" model="ir.ui.view">
        <field name="name">product.product.form.management.cost</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="after">
                <field name="ultimo_costo_mr" readonly="1"/>
                <field name="management_cost" readonly="1"/>
                <field name="management_rate" readonly="1"/>
            </field>
        </field>
    </record>

</odoo>
