<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Mantiene los últimos cortes de saldo. El histórico se rehace con el wizard de
         reconstrucción. Nace apagado, igual que el precálculo de métricas: se enciende
         cuando la instalación decide que la analítica pasa a estar viva. -->
    <record id="ir_cron_build_stock_balances" model="ir.cron">
        <field name="name">Advanced Dashboards: saldos de stock</field>
        <field name="model_id" ref="model_primate_stock_balance"/>
        <field name="state">code</field>
        <field name="code">model.cron_build_balances()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
