<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_primate_target_plan_tree" model="ir.ui.view">
        <field name="name">primate.target.plan.tree</field>
        <field name="model">primate.target.plan</field>
        <field name="arch" type="xml">
            <tree string="Planes de objetivos" decoration-muted="state == 'done'">
                <field name="name"/>
                <field name="definition_id"/>
                <field name="subject_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="target_count"/>
                <field name="state" widget="badge" decoration-info="state == 'running'"/>
            </tree>
        </field>
    </record>

    <record id="view_primate_target_plan_form" model="ir.ui.view">
        <field name="name">primate.target.plan.form</field>
        <field name="model">primate.target.plan</field>
        <field name="arch" type="xml">
            <form string="Plan de objetivos">
                <header>
                    <button name="action_generate" type="object" string="Generar objetivos"
                            class="oe_highlight" invisible="state == 'done'"/>
                    <button name="action_start_targets" type="object"
                            string="Poner todos en curso" invisible="target_count == 0"/>
                    <button name="action_close" type="object" string="Cerrar plan"
                            invisible="state != 'running'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_targets" type="object"
                                class="oe_stat_button" icon="fa-bullseye"
                                invisible="target_count == 0">
                            <field name="target_count" widget="statinfo" string="Objetivos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Metas de ventas 2026"/></h1>
                    </div>
                    <group>
                        <group string="Qué se asigna">
                            <field name="definition_id"/>
                            <field name="subject_type" readonly="1"/>
                            <field name="period_type_id" readonly="1"/>
                            <field name="default_target"/>
                        </group>
                        <group string="Vigencia">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sujetos" name="subjects">
                            <field name="company_target_ids" widget="many2many_tags"
                                   invisible="subject_type != 'company'"/>
                            <field name="employee_ids" widget="many2many_tags"
                                   invisible="subject_type != 'employee'"/>
                            <field name="user_ids" widget="many2many_tags"
                                   invisible="subject_type != 'user'"/>
                            <field name="warehouse_ids" widget="many2many_tags"
                                   invisible="subject_type != 'warehouse'"/>
                        </page>
                        <page string="Objetivos por sujeto" name="lines">
                            <p class="text-muted">Solo hace falta cargar acá los sujetos que
                                tienen un objetivo distinto del valor por defecto.</p>
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="subject_type" column_invisible="1"/>
                                    <field name="company_target_id"
                                           column_invisible="parent.subject_type != 'company'"/>
                                    <field name="employee_id"
                                           column_invisible="parent.subject_type != 'employee'"/>
                                    <field name="user_id"
                                           column_invisible="parent.subject_type != 'user'"/>
                                    <field name="warehouse_id"
                                           column_invisible="parent.subject_type != 'warehouse'"/>
                                    <field name="target_value"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_primate_target_plan" model="ir.actions.act_window">
        <field name="name">Planes de objetivos</field>
        <field name="res_model">primate.target.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Armá un plan de objetivos</p>
            <p>Un plan asigna una definición a un conjunto de empleados, usuarios o
               locales y genera un objetivo por cada período del rango.</p>
        </field>
    </record>

</odoo>
