<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_primate_metric_backfill_form" model="ir.ui.view">
        <field name="name">primate.metric.backfill.form</field>
        <field name="model">primate.metric.backfill</field>
        <field name="arch" type="xml">
            <form string="Recalcular métricas">
                <p class="text-muted">
                    Rehace la tabla de hechos del rango indicado. Se usa cuando se corrigen
                    datos históricos: el cron nocturno solo recalcula la ventana reciente.
                </p>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="scope"/>
                    </group>
                </group>
                <group invisible="scope != 'selected'">
                    <field name="version_ids" widget="many2many_tags" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Recalcular"
                            class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_primate_metric_backfill" model="ir.actions.act_window">
        <field name="name">Recalcular métricas</field>
        <field name="res_model">primate.metric.backfill</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
