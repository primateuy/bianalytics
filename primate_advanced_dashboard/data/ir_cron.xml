<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Precálculo nocturno de la tabla de hechos. Recalcula la ventana reciente para
         absorber correcciones retroactivas; para rangos históricos está el wizard de
         recálculo. -->
    <record id="ir_cron_build_metric_facts" model="ir.cron">
        <field name="name">Advanced Dashboards: precálculo de métricas</field>
        <field name="model_id" ref="model_primate_metric_fact_run"/>
        <field name="state">code</field>
        <field name="code">model.cron_build_facts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
