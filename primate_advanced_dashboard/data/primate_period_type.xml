<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Tipos de período de calendario puro. La semana ISO está desde la Fase 1
         (sección 6.1); las zafras se incorporan más adelante agregando un código
         nuevo, sin rediseñar el motor de comparativos. -->

    <record id="period_type_day" model="primate.period.type">
        <field name="name">Día</field>
        <field name="code">day</field>
        <field name="sequence">10</field>
    </record>

    <record id="period_type_iso_week" model="primate.period.type">
        <field name="name">Semana ISO</field>
        <field name="code">iso_week</field>
        <field name="sequence">20</field>
    </record>

    <record id="period_type_month" model="primate.period.type">
        <field name="name">Mes</field>
        <field name="code">month</field>
        <field name="sequence">30</field>
    </record>

    <record id="period_type_quarter" model="primate.period.type">
        <field name="name">Trimestre</field>
        <field name="code">quarter</field>
        <field name="sequence">40</field>
    </record>

    <record id="period_type_year" model="primate.period.type">
        <field name="name">Año</field>
        <field name="code">year</field>
        <field name="sequence">50</field>
    </record>

    <record id="period_type_custom" model="primate.period.type">
        <field name="name">Rango libre</field>
        <field name="code">custom</field>
        <field name="sequence">60</field>
    </record>

</odoo>
