<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_sale_snapshot" model="ir.ui.view">
        <field name="name">account.move.form.sale.snapshot</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Punto de venta" name="pos_snapshot"
                      invisible="sale_snapshot_count == 0">
                    <group>
                        <group string="La venta">
                            <field name="sale_snapshot_count" invisible="1"/>
                            <field name="pos_warehouse_id"/>
                            <field name="pos_config_id"/>
                            <field name="pos_session_id"/>
                            <field name="pos_sale_datetime"/>
                        </group>
                        <group string="Cómo se pagó">
                            <field name="sale_snapshot_payment_ids" nolabel="1"
                                   colspan="2" readonly="1">
                                <tree create="false" edit="false" delete="false">
                                    <field name="payment_method_name"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="payment_date" optional="hide"/>
                                </tree>
                            </field>
                        </group>
                    </group>
                    <separator string="Cómo estaba el producto al venderse"/>
                    <p class="text-muted">
                        Esta es la foto del producto en el momento de la venta. No cambia
                        si después le cambian la categoría, las etiquetas o el costo: para
                        eso existe.
                    </p>
                    <field name="sale_snapshot_ids" nolabel="1" readonly="1">
                        <tree create="false" edit="false" delete="false">
                            <field name="product_id"/>
                            <field name="default_code" optional="show"/>
                            <field name="employee_id" optional="show"/>
                            <field name="categ_id" optional="show"/>
                            <field name="categ_parent_id" optional="show"/>
                            <field name="tag_ids" widget="many2many_tags" optional="hide"/>
                            <field name="quantity" sum="Total"/>
                            <field name="price_unit" optional="hide"/>
                            <field name="list_price" optional="hide"/>
                            <field name="price_subtotal" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="cost_report" optional="show"/>
                            <field name="management_rate" optional="hide"/>
                            <field name="management_cost" optional="show"/>
                            <field name="management_value" sum="Total"
                                   optional="show"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
